    given-names: Neven
    website: https://github.com/Nevensky
version: 0.1.0
date-released: 2026-11-19
license: MIT
repository-code: https://github.com/Nevensky/fumadocs-feynman
url: https://nevensky.github.io/fumadocs-feynman/
keywords:
  - Feynman diagrams
  - many-body perturbation theory
  - fumadocs
  - MDX
  - SVG
